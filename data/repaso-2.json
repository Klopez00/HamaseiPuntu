  "allPhrases": [
    {"eu": "Zeinen ederra izango den", "es": "Qué bonito va a ser", "source": "Zeinen ederra izango den", "note": "Futuro con -ko + izan (izango den = que será)"},
    {"eu": "Garagardo bat zerura eroritakoen omenez", "es": "Una cerveza al cielo en honor a los caídos", "source": "Zeinen ederra izango den"},
    {"eu": "Gorroto zenituen hileta kantu nafarrak", "es": "Odiabas las canciones fúnebres navarras", "source": "Hileta kantu nafarra", "note": "zenituen = tenías/odiabas (nor-nori-nork, pasado)"},
    {"eu": "Amaren begietan", "es": "En los ojos de la madre", "source": "Hileta kantu nafarra"},
    {"eu": "Itxaron baina ez espero", "es": "Esperar (aguardar) pero no esperar (desear)", "source": "Zero", "note": "Contraste entre itxaron (aguardar) y espero (desear)"},
    {"eu": "Ez hotza ta ez bero", "es": "Ni frío ni calor", "source": "Zero", "note": "Estructura ez X ta ez Y = ni X ni Y"},
    {"eu": "Emaidazu eskua ta etorri iparraldera", "es": "Dame la mano y ven al norte", "source": "Iparraldera", "note": "Emaidazu = eman (dar) + i + azu (me lo das a mí)"},
    {"eu": "Gordeko dizut etxe bat", "es": "Te guardaré una casa", "source": "Iparraldera"},
    {"eu": "Ez dakit zenbat denbora daramadan hemen", "es": "No sé cuánto tiempo llevo aquí", "source": "Ez dakit zenbat denbora daramadan", "note": "daramadan = relativo de eraman (llevar tiempo)"},
    {"eu": "Ez da inor etorriko ta eseri zaitez", "es": "No vendrá nadie, así que siéntate", "source": "Ez dakit zenbat denbora daramadan"},
    {"eu": "Mundua konpontzea lortu bitartean", "es": "Hasta conseguir arreglar el mundo", "source": "Kantu bat", "note": "-tzea lortu = conseguir hacer algo; bitartean = mientras"},
    {"eu": "Ni zu gabe, ez noa inora", "es": "Yo sin ti, no voy a ninguna parte", "source": "Kantu bat"},
    {"eu": "Gora begira jarri naiz", "es": "Me he puesto a mirar hacia arriba", "source": "Hegan", "note": "gora begira jarri = ponerse a mirar hacia arriba"},
    {"eu": "Hortzimugaren magalean", "es": "En la falda del horizonte", "source": "Hegan", "note": "magala = falda o ladera del monte"},
    {"eu": "Ilargiko lehioan Nobita eta Doraemon", "es": "En la ventana de la luna Nobita y Doraemon", "source": "Doraemon", "note": "-ko = genitivo locativo (de la luna)"},
    {"eu": "Amets batetik bestera", "es": "De un sueño a otro", "source": "Doraemon", "note": "batetik bestera = de uno a otro"},
    {"eu": "Alai-alaia bihurri", "es": "Muy alegre, travieso", "source": "Shin-chan", "note": "Reduplicación para intensificar: alai-alaia = muy alegre"},
    {"eu": "Ni azaltzen naizenean", "es": "Cuando yo aparezco", "source": "Shin-chan", "note": "-nean = cuando (sufijo temporal)"},
    {"eu": "Zenbat aldiz marraztuko nuke zure besoetan etorkizuna", "es": "Cuántas veces dibujaría en tus brazos el futuro", "source": "Zurekin batera", "note": "Estructura desiderativa: zenbat aldiz + -ko + nuke"},
    {"eu": "Egunak hobeak baitira zurekin batera", "es": "Porque los días son mejores contigo", "source": "Zurekin batera", "note": "baitira = porque son (bait- + dira)"},
    {"eu": "Gerra hontan zurekin galdu nahi dut nik", "es": "En esta guerra yo quiero perder contigo", "source": "Sumendiak"},
    {"eu": "Lehen muxua, orain sumendia gara", "es": "El primer beso, ahora somos el volcán", "source": "Sumendiak"},
    {"eu": "Mendi tontor gainera igo behar dugu", "es": "Tenemos que subir a la cima de la montaña", "source": "Ikusi mendizaleak", "note": "behar dugu = tenemos que; gainera = hacia la cima"},
    {"eu": "Begiak zabaldurik, bihotza erretan", "es": "Con los ojos abiertos, el corazón ardiendo", "source": "Ikusi mendizaleak", "note": "-rik = estado resultante; -tan = en proceso"},
    {"eu": "Plazetako kantari, bakardadez josia", "es": "Cantor de plazas, lleno de soledad", "source": "Xalbadorren heriotza", "note": "josia = cosido; aquí usado metafóricamente como 'lleno de'"},
    {"eu": "Bertsorik sakonena, oihurik bortitzena", "es": "El verso más profundo, el grito más violento", "source": "Xalbadorren heriotza", "note": "-ena = superlativo (el más); -rik = partitivo"},
    {"eu": "Etxe bat ez delako etxe ez bada zuekin", "es": "Porque una casa no es casa si no es con vosotros", "source": "Beldurrik gabe", "note": "ez delako = porque no es; ez bada = si no es"},
    {"eu": "Zu etzan lasai gora begira", "es": "Túmbate tranquilamente mirando hacia arriba", "source": "Beldurrik gabe"}
  ]
