        {
          "eu": "Esnatu nintzen",
          "es": "(me desperté)",
          "challenge": "¿Cómo dirías \"se despertó\" (hura)?",
          "answer": "Esnatu zen",
          "explanation": "nor iragana: nintzen (ni) → zen (hura)"
        },
        {
          "eu": "Itsasoruntz begiratu nun",
          "es": "(miré hacia el mar)",
          "challenge": "¿Y si miramos nosotros (gu)?",
          "answer": "Itsasoruntz begiratu genuen",
          "explanation": "nork iragana: nuen (nik) → genuen (guk)"
        },
        {
          "eu": "Hasi nintzen",
          "es": "(empecé)",
          "challenge": "¿En presente? (empiezo)",
          "answer": "Hasten naiz",
          "explanation": "Presente habitual: -ten + nor oraina. nintzen → naiz"
        },
        {
          "eu": "Bale kume bat agertu zan",
          "es": "(apareció una cría)",
          "challenge": "¿Y si aparecieron varias crías?",
          "answer": "Bale kume batzuk agertu ziren",
          "explanation": "bat → batzuk, zen → ziren (plural)"
        },
        {
          "eu": "Kaian algaraka hasi ginan",
